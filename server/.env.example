PORT=5000
MONGODB_URI=mongodb://<user>:<password>@localhost:27017/business_manager?authSource=admin
CLIENT_ORIGIN=http://localhost:3000
# Set to 1 when the API runs behind one reverse proxy (nginx, a PaaS router...)
TRUST_PROXY=0
# Folder for uploaded images (default: server/uploads). Use one per database.
# UPLOADS_DIR=/var/lib/business-manager/uploads
# The team's time zone until an admin sets one in Admin -> Team settings
# (decides which day is "today"; default UTC).
# TEAM_TIME_ZONE=Europe/Berlin
JWT_SECRET=<long random string>
JWT_EXPIRES_IN=7d
# Admins and the team leader: at most this many hours per login (7 days).
ADMIN_SESSION_HOURS=168
# Logged out after this many minutes without use (7 days).
SESSION_IDLE_MINUTES=10080
# How many days the security log and the copies of deleted records are kept.
# 0 or unset keeps them for good; set a number to have entries older than
# that removed once a day (the removal is logged). Back up first (BUILD.md).
# AUDIT_RETENTION_DAYS=365
# DELETED_RETENTION_DAYS=365
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=<initial admin password; must be changed at first login>
